<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GHS Hazard Search Engine</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }
        
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px 30px;
            text-align: center;
        }
        
        .header h1 {
            font-size: 32px;
            margin-bottom: 10px;
            font-weight: 700;
        }
        
        .header p {
            opacity: 0.95;
            font-size: 16px;
            margin-bottom: 5px;
        }
        
        .header .subtitle {
            font-size: 13px;
            opacity: 0.85;
        }
        
        .content {
            padding: 40px;
        }
        
        .search-controls {
            background: #f9f9f9;
            padding: 30px;
            border-radius: 8px;
            margin-bottom: 30px;
            border: 1px solid #e0e0e0;
        }
        
        .search-title {
            font-size: 16px;
            font-weight: 700;
            color: #333;
            margin-bottom: 20px;
        }
        
        .search-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }
        
        .input-group {
            display: flex;
            flex-direction: column;
        }
        
        .input-group label {
            font-size: 13px;
            font-weight: 700;
            color: #333;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .input-group input {
            padding: 12px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
            font-family: inherit;
            transition: all 0.3s ease;
        }
        
        .input-group input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        }
        
        .input-group input::placeholder {
            color: #999;
        }
        
        .button-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        button {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            flex: 1;
            min-width: 140px;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
        }
        
        .btn-secondary {
            background: #f0f0f0;
            color: #333;
            flex: 1;
            min-width: 140px;
            border: 1px solid #ddd;
        }
        
        .btn-secondary:hover {
            background: #e0e0e0;
        }
        
        .btn-export {
            background: #27ae60;
            color: white;
            flex: 1;
            min-width: 140px;
        }
        
        .btn-export:hover {
            background: #229954;
            transform: translateY(-2px);
        }
        
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            border-radius: 8px;
            text-align: center;
        }
        
        .stat-number {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 8px;
        }
        
        .stat-label {
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .results-header {
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #f0f0f0;
        }
        
        .results-header h2 {
            font-size: 20px;
            color: #333;
            display: inline-block;
            margin-right: 20px;
        }
        
        .results-count {
            font-size: 14px;
            color: #667eea;
            font-weight: 600;
            display: inline-block;
        }
        
        .results-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(500px, 1fr));
            gap: 20px;
        }
        
        .result-card {
            background: white;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            padding: 20px;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }
        
        .result-card:hover {
            border-color: #667eea;
            box-shadow: 0 8px 24px rgba(102, 126, 234, 0.15);
            transform: translateY(-4px);
        }
        
        .chemical-header {
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid #f0f0f0;
        }
        
        .chemical-name {
            font-size: 18px;
            font-weight: 700;
            color: #667eea;
            word-break: break-word;
            margin-bottom: 5px;
        }
        
        .cas-number {
            font-size: 13px;
            color: #666;
            font-weight: 600;
        }
        
        .detail-section {
            margin-bottom: 15px;
        }
        
        .detail-label {
            font-size: 12px;
            font-weight: 700;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
            display: block;
        }
        
        .detail-value {
            font-size: 14px;
            color: #333;
            line-height: 1.6;
            word-break: break-word;
            background: #f9f9f9;
            padding: 10px;
            border-radius: 4px;
            border-left: 3px solid #667eea;
        }
        
        .badge-group {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }
        
        .badge {
            display: inline-block;
            background: #667eea;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        
        .badge-hazard {
            background: #e74c3c;
        }
        
        .badge-pictogram {
            background: #f39c12;
        }
        
        .badge-signal {
            background: #3498db;
        }
        
        .no-results {
            text-align: center;
            padding: 60px 20px;
            color: #999;
            grid-column: 1/-1;
        }
        
        .no-results-icon {
            font-size: 48px;
            margin-bottom: 15px;
        }
        
        @media (max-width: 1024px) {
            .results-container {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 768px) {
            .search-grid {
                grid-template-columns: 1fr;
            }
            
            .button-row {
                flex-direction: column;
            }
            
            button {
                width: 100%;
            }
            
            .header h1 {
                font-size: 24px;
            }
            
            .content {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>⚠️ GHS Hazard Search Engine</h1>
            <p>Globally Harmonized System Chemical Hazard Classification</p>
            <p class="subtitle">Search by CAS Number, Chemical Name, Hazard Category, Pictogram, Signal Word, or Hazard Statement</p>
        </div>
        
        <div class="content">
            <!-- Search Controls -->
            <div class="search-controls">
                <div class="search-title">🔍 Search Hazard Information</div>
                
                <div class="search-grid">
                    <div class="input-group">
                        <label for="casSearch">CAS Number</label>
                        <input 
                            type="text" 
                            id="casSearch" 
                            placeholder="e.g., 1332-21-4"
                            onkeypress="if(event.key === 'Enter') searchChemicals()"
                        >
                    </div>
                    <div class="input-group">
                        <label for="chemicalSearch">Chemical Name</label>
                        <input 
                            type="text" 
                            id="chemicalSearch" 
                            placeholder="e.g., Asbestos, Benzene"
                            onkeypress="if(event.key === 'Enter') searchChemicals()"
                        >
                    </div>
                    <div class="input-group">
                        <label for="hazardSearch">Hazard Category</label>
                        <input 
                            type="text" 
                            id="hazardSearch" 
                            placeholder="e.g., Acute Toxicity"
                            onkeypress="if(event.key === 'Enter') searchChemicals()"
                        >
                    </div>
                    <div class="input-group">
                        <label for="pictogramSearch">Pictogram Codes</label>
                        <input 
                            type="text" 
                            id="pictogramSearch" 
                            placeholder="e.g., GHS06, GHS08"
                            onkeypress="if(event.key === 'Enter') searchChemicals()"
                        >
                    </div>
                    <div class="input-group">
                        <label for="signalSearch">Signal Word</label>
                        <input 
                            type="text" 
                            id="signalSearch" 
                            placeholder="e.g., Danger, Warning"
                            onkeypress="if(event.key === 'Enter') searchChemicals()"
                        >
                    </div>
                    <div class="input-group">
                        <label for="statementSearch">Hazard Statement</label>
                        <input 
                            type="text" 
                            id="statementSearch" 
                            placeholder="e.g., H350, H315"
                            onkeypress="if(event.key === 'Enter') searchChemicals()"
                        >
                    </div>
                </div>
                
                <!-- Button Row -->
                <div class="button-row">
                    <button class="btn-primary" onclick="searchChemicals()">🔍 Search</button>
                    <button class="btn-secondary" onclick="resetSearch()">↺ Clear All</button>
                    <button class="btn-export" onclick="exportResults()">📥 Export Results</button>
                </div>
            </div>
            
            <!-- Statistics -->
            <div class="stats">
                <div class="stat-card">
                    <div class="stat-number" id="totalCount">0</div>
                    <div class="stat-label">Total Chemicals</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="matchCount">0</div>
                    <div class="stat-label">Results Found</div>
                </div>
            </div>
            
            <!-- Results Section -->
            <div>
                <div class="results-header">
                    <h2>Results</h2>
                    <span class="results-count" id="resultsSummary">No results</span>
                </div>
                <div class="results-container" id="resultsContainer"></div>
            </div>
        </div>
    </div>

    <!-- EMBEDDED CSV DATA - DO NOT MODIFY -->
    <script id="csv-data" type="text/csv">CAS No.,Chemical Name,Hazard Category,Pictogram Codes,Signal Word,Hazard Statement Code,Hazard Statement
"1332-21-4","Asbestos (all forms)","Acute Toxicity; Chronic Toxicity","GHS06; GHS08","Danger","H334; H372","May cause respiratory irritation; May cause damage to organs through prolonged or repeated exposure"
"14808-60-7","Crystalline silica (respirable)","Acute Toxicity; Carcinogenicity","GHS06; GHS08","Danger","H334; H350","May cause respiratory irritation; May cause cancer"
"7439-92-1","Lead and inorganic lead compounds","Acute Toxicity; Reproductive Toxicity","GHS06; GHS08","Danger","H362; H372","May damage fertility or the unborn child; May cause damage to organs through prolonged or repeated exposure"
"71-43-2","Benzene","Carcinogenicity; Flammable Liquid","GHS02; GHS08","Danger","H225; H350","Highly flammable liquid and vapour; May cause cancer"
"630-08-0","Carbon monoxide","Acute Toxicity; Gases Under Pressure","GHS04; GHS06","Warning; Danger","H280; H330","Contains gas under pressure; May be fatal if inhaled"</script>

    <script>
        let chemicalsData = [];
        let searchResults = [];

        // Initialize on page load
        window.addEventListener('load', function() {
            const csvText = document.getElementById('csv-data').textContent;
            parseCSV(csvText);
            displayAllResults();
        });

        // Parse CSV file
        function parseCSV(csv) {
            chemicalsData = [];
            const lines = csv.split('\n');
            
            // Parse header
            const headerLine = lines[0];
            const headers = parseCSVLine(headerLine);
            
            const findColumnIndex = (name) => {
                return headers.findIndex(h => 
                    h.toLowerCase().includes(name.toLowerCase())
                );
            };

            const casIdx = findColumnIndex('CAS');
            const chemicalIdx = findColumnIndex('Chemical');
            const hazardIdx = findColumnIndex('Hazard Category');
            const pictogramIdx = findColumnIndex('Pictogram');
            const signalIdx = findColumnIndex('Signal');
            const statementCodeIdx = findColumnIndex('Hazard Statement Code');
            const statementIdx = findColumnIndex('Hazard Statement');

            // Parse data rows
            for (let i = 1; i < lines.length; i++) {
                const line = lines[i].trim();
                if (!line) continue;

                const cells = parseCSVLine(line);
                if (cells.length > 0) {
                    const cas = cells[casIdx] || '';
                    const chemical = cells[chemicalIdx] || '';
                    
                    if (chemical || cas) {
                        chemicalsData.push({
                            cas: cas.trim(),
                            chemical: chemical.trim(),
                            hazardCategory: cells[hazardIdx] ? cells[hazardIdx].trim() : '',
                            pictograms: cells[pictogramIdx] ? cells[pictogramIdx].trim() : '',
                            signalWord: cells[signalIdx] ? cells[signalIdx].trim() : '',
                            statementCode: cells[statementCodeIdx] ? cells[statementCodeIdx].trim() : '',
                            statement: cells[statementIdx] ? cells[statementIdx].trim() : ''
                        });
                    }
                }
            }
        }

        // Parse CSV line (handle quoted values)
        function parseCSVLine(line) {
            const result = [];
            let current = '';
            let inQuotes = false;

            for (let i = 0; i < line.length; i++) {
                const char = line[i];
                const nextChar = line[i + 1];

                if (char === '"') {
                    if (inQuotes && nextChar === '"') {
                        current += '"';
                        i++;
                    } else {
                        inQuotes = !inQuotes;
                    }
                } else if (char === ',' && !inQuotes) {
                    result.push(current);
                    current = '';
                } else {
                    current += char;
                }
            }
            result.push(current);
            return result;
        }

        // Search chemicals
        function searchChemicals() {
            const casQuery = document.getElementById('casSearch').value.toLowerCase();
            const chemicalQuery = document.getElementById('chemicalSearch').value.toLowerCase();
            const hazardQuery = document.getElementById('hazardSearch').value.toLowerCase();
            const pictogramQuery = document.getElementById('pictogramSearch').value.toLowerCase();
            const signalQuery = document.getElementById('signalSearch').value.toLowerCase();
            const statementQuery = document.getElementById('statementSearch').value.toLowerCase();

            searchResults = chemicalsData.filter(chem => {
                let match = true;

                if (casQuery) {
                    match = match && chem.cas.toLowerCase().includes(casQuery);
                }
                if (chemicalQuery) {
                    match = match && chem.chemical.toLowerCase().includes(chemicalQuery);
                }
                if (hazardQuery) {
                    match = match && chem.hazardCategory.toLowerCase().includes(hazardQuery);
                }
                if (pictogramQuery) {
                    match = match && chem.pictograms.toLowerCase().includes(pictogramQuery);
                }
                if (signalQuery) {
                    match = match && chem.signalWord.toLowerCase().includes(signalQuery);
                }
                if (statementQuery) {
                    match = match && (chem.statementCode.toLowerCase().includes(statementQuery) || 
                                     chem.statement.toLowerCase().includes(statementQuery));
                }

                return match;
            });

            displayResults();
            updateStats();
        }

        // Display all results
        function displayAllResults() {
            searchResults = [...chemicalsData];
            displayResults();
        }

        // Display results
        function displayResults() {
            const container = document.getElementById('resultsContainer');

            if (searchResults.length === 0) {
                container.innerHTML = `
                    <div class="no-results">
                        <div class="no-results-icon">🔍</div>
                        <p>No chemicals found matching your search criteria.</p>
                    </div>
                `;
            } else {
                container.innerHTML = searchResults.map(chem => `
                    <div class="result-card">
                        <div class="chemical-header">
                            <div class="chemical-name">${escapeHtml(chem.chemical)}</div>
                            <div class="cas-number">CAS: ${escapeHtml(chem.cas)}</div>
                        </div>

                        ${chem.hazardCategory ? `
                            <div class="detail-section">
                                <label class="detail-label">Hazard Category</label>
                                <div class="badge-group">
                                    ${chem.hazardCategory.split(';').map(h => 
                                        `<span class="badge badge-hazard">${escapeHtml(h.trim())}</span>`
                                    ).join('')}
                                </div>
                            </div>
                        ` : ''}

                        ${chem.pictograms ? `
                            <div class="detail-section">
                                <label class="detail-label">Pictogram Codes</label>
                                <div class="badge-group">
                                    ${chem.pictograms.split(';').map(p => 
                                        `<span class="badge badge-pictogram">${escapeHtml(p.trim())}</span>`
                                    ).join('')}
                                </div>
                            </div>
                        ` : ''}

                        ${chem.signalWord ? `
                            <div class="detail-section">
                                <label class="detail-label">Signal Word</label>
                                <div class="badge-group">
                                    ${chem.signalWord.split(';').map(s => 
                                        `<span class="badge badge-signal">${escapeHtml(s.trim())}</span>`
                                    ).join('')}
                                </div>
                            </div>
                        ` : ''}

                        ${chem.statementCode ? `
                            <div class="detail-section">
                                <label class="detail-label">Hazard Statement Code</label>
                                <div class="detail-value">${escapeHtml(chem.statementCode)}</div>
                            </div>
                        ` : ''}

                        ${chem.statement ? `
                            <div class="detail-section">
                                <label class="detail-label">Hazard Statement</label>
                                <div class="detail-value">${escapeHtml(chem.statement)}</div>
                            </div>
                        ` : ''}
                    </div>
                `).join('');
            }

            updateStats();
        }

        // Update statistics
        function updateStats() {
            document.getElementById('totalCount').textContent = chemicalsData.length;
            document.getElementById('matchCount').textContent = searchResults.length;
            
            const summary = searchResults.length === chemicalsData.length 
                ? `All ${searchResults.length} chemicals` 
                : `${searchResults.length} of ${chemicalsData.length} chemicals`;
            document.getElementById('resultsSummary').textContent = summary;
        }

        // Reset search
        function resetSearch() {
            document.getElementById('casSearch').value = '';
            document.getElementById('chemicalSearch').value = '';
            document.getElementById('hazardSearch').value = '';
            document.getElementById('pictogramSearch').value = '';
            document.getElementById('signalSearch').value = '';
            document.getElementById('statementSearch').value = '';
            displayAllResults();
        }

        // Export results
        function exportResults() {
            if (searchResults.length === 0) {
                alert('No results to export');
                return;
            }

            const headers = ['CAS No.', 'Chemical Name', 'Hazard Category', 'Pictogram Codes', 'Signal Word', 'Hazard Statement Code', 'Hazard Statement'];
            let csv = headers.map(h => `"${h}"`).join(',') + '\n';

            searchResults.forEach(chem => {
                const row = [
                    chem.cas,
                    chem.chemical,
                    chem.hazardCategory,
                    chem.pictograms,
                    chem.signalWord,
                    chem.statementCode,
                    chem.statement
                ];
                csv += row.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(',') + '\n';
            });

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `ghs-hazard-search-${new Date().toISOString().split('T')[0]}.csv`;
            link.click();
        }

        // Escape HTML
        function escapeHtml(text) {
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return String(text).replace(/[&<>"']/g, m => map[m]);
        }
    </script>
</body>
</html>
