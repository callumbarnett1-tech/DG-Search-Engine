<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GHS Hazard Search Engine</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }
        
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px 30px;
            text-align: center;
        }
        
        .header h1 {
            font-size: 32px;
            margin-bottom: 10px;
            font-weight: 700;
        }
        
        .header p {
            opacity: 0.95;
            font-size: 16px;
            margin-bottom: 5px;
        }
        
        .header .subtitle {
            font-size: 13px;
            opacity: 0.85;
        }
        
        .content {
            padding: 40px;
        }
        
        .search-controls {
            background: #f9f9f9;
            padding: 30px;
            border-radius: 8px;
            margin-bottom: 30px;
            border: 1px solid #e0e0e0;
        }
        
        .search-title {
            font-size: 16px;
            font-weight: 700;
            color: #333;
            margin-bottom: 20px;
        }
        
        .search-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }
        
        .input-group {
            display: flex;
            flex-direction: column;
        }
        
        .input-group label {
            font-size: 12px;
            font-weight: 700;
            color: #333;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .input-group input {
            padding: 12px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
            font-family: inherit;
            transition: all 0.3s ease;
        }
        
        .input-group input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        }
        
        .input-group input::placeholder {
            color: #999;
            font-size: 13px;
        }
        
        .button-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        button {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            flex: 1;
            min-width: 120px;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
        }
        
        .btn-primary:active {
            transform: translateY(0);
        }
        
        .btn-secondary {
            background: #f0f0f0;
            color: #333;
            border: 1px solid #ddd;
        }
        
        .btn-secondary:hover {
            background: #e0e0e0;
        }
        
        .btn-export {
            background: #27ae60;
            color: white;
        }
        
        .btn-export:hover {
            background: #229954;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(39, 174, 96, 0.3);
        }
        
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            border-radius: 8px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.2);
        }
        
        .stat-number {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 8px;
        }
        
        .stat-label {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            opacity: 0.95;
        }
        
        .results-header {
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #f0f0f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .results-header h2 {
            font-size: 20px;
            color: #333;
            font-weight: 700;
        }
        
        .results-count {
            font-size: 14px;
            color: #667eea;
            font-weight: 600;
        }
        
        .results-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(480px, 1fr));
            gap: 20px;
        }
        
        .result-card {
            background: white;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            padding: 24px;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }
        
        .result-card:hover {
            border-color: #667eea;
            box-shadow: 0 8px 24px rgba(102, 126, 234, 0.15);
            transform: translateY(-4px);
        }
        
        .chemical-header {
            margin-bottom: 18px;
            padding-bottom: 12px;
            border-bottom: 2px solid #f0f0f0;
        }
        
        .chemical-name {
            font-size: 18px;
            font-weight: 700;
            color: #667eea;
            word-break: break-word;
            margin-bottom: 6px;
        }
        
        .cas-number {
            font-size: 13px;
            color: #666;
            font-weight: 600;
            font-family: monospace;
        }
        
        .detail-section {
            margin-bottom: 16px;
        }
        
        .detail-label {
            font-size: 11px;
            font-weight: 700;
            color: #555;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
            display: block;
        }
        
        .detail-value {
            font-size: 14px;
            color: #333;
            line-height: 1.6;
            word-break: break-word;
        }
        
        .badge-group {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        
        .badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }
        
        .badge-hazard {
            background: #ffe0e0;
            color: #c0392b;
            border: 1px solid #e74c3c;
        }
        
        .badge-pictogram {
            background: #fff4e0;
            color: #d68910;
            border: 1px solid #f39c12;
        }
        
        .badge-signal {
            background: #e0f2ff;
            color: #1565c0;
            border: 1px solid #3498db;
        }
        
        .value-box {
            background: #f9f9f9;
            padding: 12px;
            border-radius: 6px;
            border-left: 3px solid #667eea;
        }
        
        .no-results {
            text-align: center;
            padding: 60px 20px;
            color: #999;
            grid-column: 1/-1;
        }
        
        .no-results-icon {
            font-size: 48px;
            margin-bottom: 15px;
            opacity: 0.5;
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #999;
        }
        
        .empty-state-icon {
            font-size: 48px;
            margin-bottom: 15px;
            opacity: 0.5;
        }
        
        @media (max-width: 1024px) {
            .results-container {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 768px) {
            .search-grid {
                grid-template-columns: 1fr;
            }
            
            .button-row {
                flex-direction: column;
            }
            
            button {
                width: 100%;
            }
            
            .header h1 {
                font-size: 24px;
            }
            
            .content {
                padding: 20px;
            }
            
            .results-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>⚠️ GHS Hazard Search Engine</h1>
            <p>Globally Harmonized System Chemical Hazard Classification</p>
            <p class="subtitle">Search embedded data by CAS Number, Chemical Name, Hazard Category, Pictogram, Signal Word, or Hazard Statement</p>
        </div>
        
        <div class="content">
            <!-- Search Controls -->
            <div class="search-controls">
                <div class="search-title">🔍 Search Hazard Information</div>
                
                <div class="search-grid">
                    <div class="input-group">
                        <label for="casSearch">CAS No.</label>
                        <input 
                            type="text" 
                            id="casSearch" 
                            placeholder="e.g., 1332-21-4"
                            onkeypress="if(event.key === 'Enter') searchChemicals()"
                        >
                    </div>
                    <div class="input-group">
                        <label for="chemicalSearch">Chemical Name</label>
                        <input 
                            type="text" 
                            id="chemicalSearch" 
                            placeholder="e.g., Asbestos, Benzene"
                            onkeypress="if(event.key === 'Enter') searchChemicals()"
                        >
                    </div>
                    <div class="input-group">
                        <label for="hazardSearch">Hazard Category</label>
                        <input 
                            type="text" 
                            id="hazardSearch" 
                            placeholder="e.g., Acute Toxicity"
                            onkeypress="if(event.key === 'Enter') searchChemicals()"
                        >
                    </div>
                    <div class="input-group">
                        <label for="pictogramSearch">Pictogram Codes</label>
                        <input 
                            type="text" 
                            id="pictogramSearch" 
                            placeholder="e.g., GHS06, GHS08"
                            onkeypress="if(event.key === 'Enter') searchChemicals()"
                        >
                    </div>
                    <div class="input-group">
                        <label for="signalSearch">Signal Word</label>
                        <input 
                            type="text" 
                            id="signalSearch" 
                            placeholder="e.g., Danger, Warning"
                            onkeypress="if(event.key === 'Enter') searchChemicals()"
                        >
                    </div>
                    <div class="input-group">
                        <label for="statementSearch">Hazard Statement Code/Text</label>
                        <input 
                            type="text" 
                            id="statementSearch" 
                            placeholder="e.g., H350, H315, cancer"
                            onkeypress="if(event.key === 'Enter') searchChemicals()"
                        >
                    </div>
                </div>
                
                <!-- Button Row -->
                <div class="button-row">
                    <button class="btn-primary" onclick="searchChemicals()">🔍 Search</button>
                    <button class="btn-secondary" onclick="resetSearch()">↺ Clear All</button>
                    <button class="btn-export" onclick="exportResults()">📥 Export CSV</button>
                </div>
            </div>
            
            <!-- Statistics -->
            <div class="stats">
                <div class="stat-card">
                    <div class="stat-number" id="totalCount">0</div>
                    <div class="stat-label">Total Chemicals</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="matchCount">0</div>
                    <div class="stat-label">Results Found</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="hazardCount">0</div>
                    <div class="stat-label">Hazard Categories</div>
                </div>
            </div>
            
            <!-- Results Section -->
            <div id="resultsSection" style="display: none;">
                <div class="results-header">
                    <h2>Results</h2>
                    <span class="results-count" id="resultsSummary">0 chemicals found</span>
                </div>
                <div class="results-container" id="resultsContainer"></div>
            </div>
            
            <!-- Empty State -->
            <div id="emptyState">
                <div class="empty-state">
                    <div class="empty-state-icon">🧪</div>
                    <p style="font-size: 16px; margin-bottom: 10px;">Welcome to GHS Hazard Search</p>
                    <p style="font-size: 13px; color: #aaa;">Enter search terms above to find chemicals by CAS Number, Chemical Name, Hazard Category, Pictogram Codes, Signal Word, or Hazard Statement</p>
                </div>
            </div>
        </div>
    </div>

    <!-- EMBEDDED CSV DATA -->
    <script id="csv-data" type="text/csv">CAS No.,Chemical Name,Hazard Category,Pictogram Codes,Signal Word,Hazard Statement Code,Hazard Statement
"1332-21-4","Asbestos (all forms)","Acute Toxicity; Chronic Toxicity; Carcinogenicity","GHS06; GHS08","Danger","H334; H372; H350","May cause respiratory irritation; May cause damage to organs through prolonged or repeated exposure; May cause cancer"
"14808-60-7","Crystalline silica (respirable)","Acute Toxicity; Carcinogenicity; Respiratory Sensitization","GHS06; GHS08","Danger","H334; H350","May cause respiratory irritation; May cause cancer"
"7439-92-1","Lead and inorganic lead compounds","Acute Toxicity; Reproductive Toxicity; Specific Target Organ Toxicity","GHS06; GHS08","Danger","H362; H372; H360","May damage fertility or the unborn child; May cause damage to organs through prolonged or repeated exposure; May damage fertility or the unborn child"
"71-43-2","Benzene","Carcinogenicity; Flammable Liquid; Specific Target Organ Toxicity","GHS02; GHS08","Danger","H225; H350; H372","Highly flammable liquid and vapour; May cause cancer; May cause damage to organs through prolonged or repeated exposure"
"630-08-0","Carbon monoxide","Acute Toxicity; Gases Under Pressure","GHS04; GHS06","Warning; Danger","H280; H330","Contains gas under pressure; May be fatal if inhaled"
"50-00-0","Formaldehyde (Methanal)","Acute Toxicity; Respiratory Sensitization; Skin Irritation","GHS06; GHS08","Danger; Warning","H315; H317; H334; H350","Causes skin irritation; May cause an allergic skin reaction; May cause respiratory irritation; May cause cancer"
"108-88-3","Toluene (Methylbenzene)","Acute Toxicity; Flammable Liquid; Reproductive Toxicity","GHS02; GHS06; GHS08","Danger; Warning","H225; H361; H373","Highly flammable liquid and vapour; Suspected of damaging fertility or the unborn child; May cause damage to organs through prolonged or repeated exposure"
"1330-20-7","Xylene (Dimethylbenzene)","Acute Toxicity; Flammable Liquid; Specific Target Organ Toxicity","GHS02; GHS06; GHS08","Danger; Warning","H225; H315; H373","Highly flammable liquid and vapour; Causes skin irritation; May cause damage to organs through prolonged or repeated exposure"
"67-64-1","Acetone (Propanone)","Flammable Liquid; Serious Eye Irritation; Specific Target Organ Toxicity","GHS02; GHS07","Warning","H225; H319; H336","Highly flammable liquid and vapour; Causes serious eye irritation; May cause drowsiness or dizziness"
"64-17-5","Ethanol (Ethyl alcohol)","Flammable Liquid","GHS02","Warning","H225","Highly flammable liquid and vapour"
"7732-18-5","Water","No Hazard Classification","None","None","None","None"
"74-82-8","Methane","Flammable Gas; Gases Under Pressure","GHS02; GHS04","Warning; Danger","H220; H280","Extremely flammable gas; Contains gas under pressure"
"7664-41-7","Ammonia (aqueous solution)","Acute Toxicity; Corrosivity; Respiratory Sensitization","GHS05; GHS06; GHS08","Danger; Warning","H314; H335; H317","Causes severe skin burns and eye damage; May cause respiratory irritation; May cause an allergic skin reaction"
"7647-01-0","Hydrogen chloride (Hydrochloric acid)","Acute Toxicity; Corrosivity; Specific Target Organ Toxicity","GHS05; GHS06; GHS08","Danger; Warning","H314; H335","Causes severe skin burns and eye damage; May cause respiratory irritation"
"7664-93-9","Sulfuric acid","Corrosivity; Specific Target Organ Toxicity","GHS05; GHS08","Danger","H314; H372","Causes severe skin burns and eye damage; May cause damage to organs through prolonged or repeated exposure"</script>

    <script>
        let chemicalsData = [];
        let searchResults = [];

        // Initialize on page load
        window.addEventListener('load', function() {
            const csvText = document.getElementById('csv-data').textContent;
            parseCSV(csvText);
            updateStats();
        });

        // Parse CSV data
        function parseCSV(csv) {
            chemicalsData = [];
            const lines = csv.trim().split('\n');
            
            if (lines.length < 2) {
                console.error('Invalid CSV format');
                return;
            }
            
            // Parse header row
            const headerLine = lines[0];
            const headers = parseCSVLine(headerLine).map(h => h.toLowerCase().trim());
            
            // Find column indices
            const casIdx = headers.findIndex(h => h.includes('cas'));
            const chemicalIdx = headers.findIndex(h => h.includes('chemical') && h.includes('name'));
            const hazardIdx = headers.findIndex(h => h.includes('hazard') && h.includes('category'));
            const pictogramIdx = headers.findIndex(h => h.includes('pictogram'));
            const signalIdx = headers.findIndex(h => h.includes('signal'));
            const statementCodeIdx = headers.findIndex(h => h.includes('hazard statement code'));
            const statementIdx = headers.findIndex(h => h.includes('hazard statement') && !h.includes('code'));

            // Parse data rows
            for (let i = 1; i < lines.length; i++) {
                const line = lines[i].trim();
                if (!line) continue;

                const cells = parseCSVLine(line);
                
                if (cells.length > Math.max(casIdx, chemicalIdx)) {
                    const cas = cells[casIdx] ? cells[casIdx].trim() : '';
                    const chemical = cells[chemicalIdx] ? cells[chemicalIdx].trim() : '';
                    
                    if (chemical || cas) {
                        chemicalsData.push({
                            cas: cas,
                            chemical: chemical,
                            hazardCategory: cells[hazardIdx] ? cells[hazardIdx].trim() : '',
                            pictograms: cells[pictogramIdx] ? cells[pictogramIdx].trim() : '',
                            signalWord: cells[signalIdx] ? cells[signalIdx].trim() : '',
                            statementCode: cells[statementCodeIdx] ? cells[statementCodeIdx].trim() : '',
                            statement: cells[statementIdx] ? cells[statementIdx].trim() : ''
                        });
                    }
                }
            }
        }

        // Parse CSV line handling quoted values
        function parseCSVLine(line) {
            const result = [];
            let current = '';
            let inQuotes = false;

            for (let i = 0; i < line.length; i++) {
                const char = line[i];
                const nextChar = line[i + 1];

                if (char === '"') {
                    if (inQuotes && nextChar === '"') {
                        current += '"';
                        i++;
                    } else {
                        inQuotes = !inQuotes;
                    }
                } else if (char === ',' && !inQuotes) {
                    result.push(current);
                    current = '';
                } else {
                    current += char;
                }
            }
            result.push(current);
            return result;
        }

        // Search chemicals
        function searchChemicals() {
            const casQuery = document.getElementById('casSearch').value.toLowerCase().trim();
            const chemicalQuery = document.getElementById('chemicalSearch').value.toLowerCase().trim();
            const hazardQuery = document.getElementById('hazardSearch').value.toLowerCase().trim();
            const pictogramQuery = document.getElementById('pictogramSearch').value.toLowerCase().trim();
            const signalQuery = document.getElementById('signalSearch').value.toLowerCase().trim();
            const statementQuery = document.getElementById('statementSearch').value.toLowerCase().trim();

            searchResults = chemicalsData.filter(chem => {
                let match = true;

                if (casQuery) {
                    match = match && chem.cas.toLowerCase().includes(casQuery);
                }
                if (chemicalQuery) {
                    match = match && chem.chemical.toLowerCase().includes(chemicalQuery);
                }
                if (hazardQuery) {
                    match = match && chem.hazardCategory.toLowerCase().includes(hazardQuery);
                }
                if (pictogramQuery) {
                    match = match && chem.pictograms.toLowerCase().includes(pictogramQuery);
                }
                if (signalQuery) {
                    match = match && chem.signalWord.toLowerCase().includes(signalQuery);
                }
                if (statementQuery) {
                    match = match && (chem.statementCode.toLowerCase().includes(statementQuery) || 
                                     chem.statement.toLowerCase().includes(statementQuery));
                }

                return match;
            });

            displayResults();
            updateStats();
        }

        // Display results
        function displayResults() {
            const container = document.getElementById('resultsContainer');
            const section = document.getElementById('resultsSection');
            const emptyState = document.getElementById('emptyState');

            if (searchResults.length === 0) {
                container.innerHTML = `
                    <div class="no-results">
                        <div class="no-results-icon">🔍</div>
                        <p>No chemicals found matching your search criteria.</p>
                        <p style="font-size: 12px; margin-top: 10px; color: #bbb;">Try adjusting your search terms or clear filters</p>
                    </div>
                `;
                section.style.display = 'block';
                emptyState.style.display = 'none';
            } else {
                container.innerHTML = searchResults.map(chem => `
                    <div class="result-card">
                        <div class="chemical-header">
                            <div class="chemical-name">${escapeHtml(chem.chemical)}</div>
                            ${chem.cas ? `<div class="cas-number">CAS: ${escapeHtml(chem.cas)}</div>` : ''}
                        </div>

                        ${chem.hazardCategory && chem.hazardCategory !== 'None' ? `
                            <div class="detail-section">
                                <label class="detail-label">Hazard Category</label>
                                <div class="badge-group">
                                    ${chem.hazardCategory.split(';').map(h => 
                                        `<span class="badge badge-hazard">${escapeHtml(h.trim())}</span>`
                                    ).join('')}
                                </div>
                            </div>
                        ` : ''}

                        ${chem.pictograms && chem.pictograms !== 'None' ? `
                            <div class="detail-section">
                                <label class="detail-label">Pictogram Codes</label>
                                <div class="badge-group">
                                    ${chem.pictograms.split(';').map(p => 
                                        `<span class="badge badge-pictogram">${escapeHtml(p.trim())}</span>`
                                    ).join('')}
                                </div>
                            </div>
                        ` : ''}

                        ${chem.signalWord && chem.signalWord !== 'None' ? `
                            <div class="detail-section">
                                <label class="detail-label">Signal Word</label>
                                <div class="badge-group">
                                    ${chem.signalWord.split(';').map(s => 
                                        `<span class="badge badge-signal">${escapeHtml(s.trim())}</span>`
                                    ).join('')}
                                </div>
                            </div>
                        ` : ''}

                        ${chem.statementCode && chem.statementCode !== 'None' ? `
                            <div class="detail-section">
                                <label class="detail-label">Hazard Statement Code</label>
                                <div class="value-box">${escapeHtml(chem.statementCode)}</div>
                            </div>
                        ` : ''}

                        ${chem.statement && chem.statement !== 'None' ? `
                            <div class="detail-section">
                                <label class="detail-label">Hazard Statement</label>
                                <div class="value-box">${escapeHtml(chem.statement)}</div>
                            </div>
                        ` : ''}
                    </div>
                `).join('');
                
                section.style.display = 'block';
                emptyState.style.display = 'none';
            }

            updateStats();
        }

        // Update statistics
        function updateStats() {
            document.getElementById('totalCount').textContent = chemicalsData.length;
            document.getElementById('matchCount').textContent = searchResults.length;
            
            const hazardSet = new Set();
            searchResults.forEach(c => {
                if (c.hazardCategory && c.hazardCategory !== 'None') {
                    c.hazardCategory.split(';').forEach(h => hazardSet.add(h.trim()));
                }
            });
            document.getElementById('hazardCount').textContent = hazardSet.size;
            
            const summary = searchResults.length === chemicalsData.length 
                ? `All ${searchResults.length} chemicals` 
                : `${searchResults.length} of ${chemicalsData.length} chemicals`;
            document.getElementById('resultsSummary').textContent = summary;
        }

        // Reset search
        function resetSearch() {
            document.getElementById('casSearch').value = '';
            document.getElementById('chemicalSearch').value = '';
            document.getElementById('hazardSearch').value = '';
            document.getElementById('pictogramSearch').value = '';
            document.getElementById('signalSearch').value = '';
            document.getElementById('statementSearch').value = '';
            document.getElementById('resultsSection').style.display = 'none';
            document.getElementById('emptyState').style.display = 'block';
            searchResults = [];
            updateStats();
        }

        // Export results
        function exportResults() {
            if (searchResults.length === 0) {
                alert('No results to export. Please perform a search first.');
                return;
            }

            const headers = ['CAS No.', 'Chemical Name', 'Hazard Category', 'Pictogram Codes', 'Signal Word', 'Hazard Statement Code', 'Hazard Statement'];
            let csv = headers.map(h => `"${h}"`).join(',') + '\n';

            searchResults.forEach(chem => {
                const row = [
                    chem.cas,
                    chem.chemical,
                    chem.hazardCategory,
                    chem.pictograms,
                    chem.signalWord,
                    chem.statementCode,
                    chem.statement
                ];
                csv += row.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(',') + '\n';
            });

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `ghs-hazard-search-${new Date().toISOString().split('T')[0]}.csv`;
            link.click();
        }

        // Escape HTML
        function escapeHtml(text) {
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return String(text).replace(/[&<>"']/g, m => map[m]);
        }
    </script>
</body>
</html>
